    "id": "fujiang:web-cms:cve-2019-11043-phpfpm-underflow",
    "category": "web-cms",
    "source_ref": "plugin/knowledge/web-cms/cve-2019-11043-phpfpm-underflow.md",
    "metadata": {
      "title": "PHP-FPM 路径信息下溢 RCE",
      "cve": "CVE-2019-11043",
      "severity": "critical",
      "source_cvss": "9.8",
      "product": "PHP-FPM + Nginx（特定 fastcgi_split_path_info 配置）",
      "versions": "PHP 7.1.x < 7.1.33、7.2.x < 7.2.24、7.3.x < 7.3.11",
      "ports": "80, 443",
      "keywords": "phpfpm, nginx, fastcgi, cve-2019-11043, phuip-fpizdam",
      "verified": "false",
      "sources": "NVD / 厂商公告 / 公开分析（见文末参考）"
    },
    "metadata_origin": "uploaded-archive-frontmatter",
    "source_sections": {
      "fingerprint": true,
      "preconditions": true,
      "remediation": true,
      "references": true
    },
    "remediation_source": "- 升级 PHP 到 7.1.33 / 7.2.24 / 7.3.11 及以上。\n- 临时：Nginx 配置 `fastcgi_param PATH_INFO $fastcgi_path_info;` 前加 `fastcgi_split_path_info ^(.+\\.php)(/.+)$` 严格匹配，或直接 `try_files $uri =404`。",
    "reference_notes": "- NVD CVE-2019-11043；phuip-fpizdam 项目；PHP 7.3.11 changelog。",
    "mirror_url": "https://github.com/sanjiu2024/dsh-team-workflow/blob/c55070e2858c1677bbebaf6ec1e8f13dad366cd6/skills/kb-web-cms/cve-2019-11043-phpfpm-underflow.md"
  },
