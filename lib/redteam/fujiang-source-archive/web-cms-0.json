      "cve": "CVE-2021-41773 / CVE-2021-42013",
      "severity": "critical",
      "source_cvss": "9.8",
      "product": "Apache HTTP Server",
      "versions": "2.4.49（41773）、2.4.50（42013 绕过）",
      "ports": "80, 443",
      "keywords": "httpd, apache, path traversal, cgi, mod_cgi, printf",
      "verified": "false",
      "sources": "NVD / 厂商公告 / 公开分析（见文末参考）"
