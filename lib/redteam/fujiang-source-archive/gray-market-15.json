      "versions": "任意",
      "ports": "80, 443",
      "keywords": "jwt, alg none, hmac, hashcat 16500, kid, 越权, 提权",
      "verified": "false",
      "sources": "公开资料整理（业务逻辑 / 实现 / 配置缺陷类，无 CVE；出处见文末参考）"
