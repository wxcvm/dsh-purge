        "title": "Redis 未授权（写文件 / 模块加载 / 主从复制）",
        "cve": "无单一 CVE（CVE-2022-0543 为 Debian 特例）",
        "severity": "critical",
        "source_cvss": "9.8",
        "product": "Redis",
        "versions": "任意（无认证 + 暴露）",
        "ports": "6379, 6380",
        "keywords": "redis, unauth, config-set, rdb, cron, module-load, replica",
        "verified": "false",
        "sources": "公开资料整理（业务逻辑 / 实现 / 配置缺陷类，无 CVE；出处见文末参考）"
      },
      "fingerprint": "返回 `redis_version` 即未授权。",
      "preconditions": "- 6379 可达且 `requirepass` 为空；Redis 进程用户对目标目录可写。",
