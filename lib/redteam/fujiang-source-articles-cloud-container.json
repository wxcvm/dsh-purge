      "metadata": {
        "title": "runc 文件描述符泄露逃逸（Leaky Vessels）",
        "cve": "CVE-2024-21626",
        "severity": "critical",
        "source_cvss": "8.6",
        "product": "runc（Docker / containerd / K8s 运行时）",
        "versions": "runc <= 1.1.11（1.1.12 修复）",
        "ports": "本地",
