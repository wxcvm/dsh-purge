      "id": "fujiang:java-web:cve-2017-12615-tomcat-put",
      "category": "java-web",
      "source_ref": "plugin/knowledge/java-web/cve-2017-12615-tomcat-put.md",
      "mirror_ref": "skills/kb-java-web/cve-2017-12615-tomcat-put.md",
      "mirror_url": "https://github.com/sanjiu2024/dsh-team-workflow/blob/c55070e2858c1677bbebaf6ec1e8f13dad366cd6/skills/kb-java-web/cve-2017-12615-tomcat-put.md",
      "metadata": {
        "title": "Tomcat PUT 任意文件写入（JSP 落地）",
        "cve": "CVE-2017-12615",
        "severity": "critical",
        "source_cvss": "",
        "product": "Apache Tomcat（Windows 部署 + readonly=false）",
        "versions": "7.0.0 - 7.0.79",
        "ports": [
          8080,
          8009
        ],
        "keywords": [
          "tomcat",
          "put",
          "jsp",
          "readonly",
          "windows",
          "12615"
        ],
        "entry": "",
        "verified": "false",
        "sources": ""
      },
      "metadata_origin": "archive-index-fallback",
      "fingerprint": "- 8080 上 Tomcat 页；`OPTIONS /` 返回 `Allow: GET,HEAD,POST,PUT,DELETE,OPTIONS`（PUT 开着）。",
      "preconditions": "- `conf/web.xml` 里 `DefaultServlet` 的 `readonly` 被改成 `false`（老教程常见）；Windows 部署更易成功。",
      "remediation_source": "- 升级到 7.0.81+；`readonly` 保持 `true`；禁止 PUT；Tomcat 以低权用户运行。",
      "reference_notes": "- NVD CVE-2017-12615；Tomcat 7.0.81 安全公告。",
      "references": []
    },
