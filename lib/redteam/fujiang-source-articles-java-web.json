    {
      "id": "fujiang:java-web:cve-2020-1938-tomcat-ajp-ghostcat",
      "category": "java-web",
      "source_ref": "plugin/knowledge/java-web/cve-2020-1938-tomcat-ajp-ghostcat.md",
      "mirror_ref": "skills/kb-java-web/cve-2020-1938-tomcat-ajp-ghostcat.md",
      "mirror_url": "https://github.com/sanjiu2024/dsh-team-workflow/blob/c55070e2858c1677bbebaf6ec1e8f13dad366cd6/skills/kb-java-web/cve-2020-1938-tomcat-ajp-ghostcat.md",
      "metadata": {
        "title": "Tomcat AJP 文件读取 / 包含（Ghostcat）",
        "cve": "CVE-2020-1938",
        "severity": "critical",
        "source_cvss": "9.8",
        "product": "Apache Tomcat",
        "versions": "6.x、7.x < 7.0.100、8.5.x < 8.5.51、9.x < 9.0.31",
        "ports": "8009, 8080",
        "keywords": "tomcat, ajp, ghostcat, web.xml, 文件包含",
        "entry": "AJP 8009 读 WEB-INF/web.xml",
        "verified": "false",
        "sources": "NVD / 厂商公告 / 公开分析（见文末参考）"
      },
      "metadata_origin": "source-frontmatter",
      "fingerprint": "- 8009 端口开放（AJP）；`nmap -p8009 --script ajp-*`；8080 有 Tomcat 页面。",
      "preconditions": "- AJP 连接器对外开放（默认 8009 只在 127.0.0.1，很多部署改成 0.0.0.0）；存在可上传/可写文件才能升到 RCE。",
      "remediation_source": "- 升级到 7.0.100 / 8.5.51 / 9.0.31+；AJP 只绑 127.0.0.1，并设置 `secret`（`requiredSecret`）。\n- 不需要 AJP 时直接注释掉 `<Connector protocol=\"AJP/1.3\">`。",
      "reference_notes": "- NVD CVE-2020-1938；Tomcat 官方公告；ajpShooter 项目。",
      "references": []
    },
