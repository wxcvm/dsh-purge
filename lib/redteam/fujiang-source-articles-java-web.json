      "metadata": {
        "title": "Apache Solr Velocity 模板注入 RCE",
        "cve": "CVE-2019-17558",
        "severity": "high",
        "source_cvss": "8.0",
        "product": "Apache Solr",
        "versions": "5.0.0 - 8.3.1",
        "ports": "8983",
        "keywords": "solr, velocity, params.resource.loader, template, cve-2019-17558",
        "entry": "",
        "verified": "false",
        "sources": "NVD / 厂商公告 / 公开分析（见文末参考）"
      },
      "metadata_origin": "source-frontmatter",
      "fingerprint": "- `/solr/` 管理页；响应含 `SolrCore Initialization Failures`；`/solr/admin/cores?wt=json` 列 core。",
      "preconditions": "- 能访问 `/solr/<core>/config`（未授权或弱口令 admin）。",
      "remediation_source": "- 升级到 8.4.0+；关闭 `params.resource.loader.enabled`；`/solr/admin` 加认证并限制来源。",
      "reference_notes": "- NVD CVE-2019-17558；Apache Solr 8.4.0 安全公告。",
      "references": []
