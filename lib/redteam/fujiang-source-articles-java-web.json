      "id": "fujiang:java-web:cve-2019-17558-solr-velocity",
      "category": "java-web",
      "source_ref": "plugin/knowledge/java-web/cve-2019-17558-solr-velocity.md",
      "mirror_ref": "skills/kb-java-web/cve-2019-17558-solr-velocity.md",
